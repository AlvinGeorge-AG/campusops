# Gemini free tier - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Google OAuth - you will create these in next step
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Mock mode - true = no real Google API calls (for testing without OAuth)
MOCK_MODE=false

# Production room sheet - create via: python scripts/create_room_sheet.py (uses throwaway account, 1 API call)
# Or manually upload backend/data/rooms_production.csv to Google Sheets and paste ID here
ROOM_SHEET_ID=
MOCK_ROOM_SHEET_ID=  # deprecated alias for ROOM_SHEET_ID
FORM_RESPONSE_SHEET_ID=

# Optional header image for forms (public URL) - will appear as banner at top of form
FORM_HEADER_IMAGE_URL=

# Poller: set to true to auto-sync Forms→Sheet every 60s without manual Link click (costs ~2 API calls/min per live event)
POLLER_ENABLED=false

# Gmail - who receives the draft permission email / announcement
FACULTY_EMAIL=faculty@example.com
ANNOUNCEMENT_RECIPIENTS=students@example.com
