# Gemini free tier - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Google OAuth - you will create these in next step
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Mock mode - true = no real Google API calls (for testing without OAuth)
MOCK_MODE=false

# Mock room sheet ID (if using real Sheets, paste sheet ID here)
MOCK_ROOM_SHEET_ID=
FORM_RESPONSE_SHEET_ID=

# Gmail - who receives the draft permission email / announcement
FACULTY_EMAIL=faculty@example.com
ANNOUNCEMENT_RECIPIENTS=students@example.com
